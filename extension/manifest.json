{
  "manifest_version": 3,
  "name": "Media Hub — Send to App",
  "short_name": "Media Hub",
  "version": "1.13.0",
  "description": "Send the current tab (or any link/video) straight into Media Hub's download queue. Pairs with the desktop app via localhost.",

  "permissions": [
    "activeTab",
    "contextMenus",
    "storage",
    "notifications",
    "tabs",
    "webRequest",
    "cookies"
  ],

  "host_permissions": [
    "http://127.0.0.1/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*.reddit.com/*",
    "https://reddit.com/*",
    "https://*.pinterest.com/*",
    "https://pinterest.com/*",
    "https://*.pinterest.co.uk/*",
    "https://*.pinterest.ca/*",
    "https://*.pinterest.com.au/*",
    "https://*.pinterest.de/*",
    "https://*.pinterest.fr/*",
    "https://*.pinterest.es/*",
    "https://*.pinterest.it/*",
    "https://*.pinterest.jp/*",
    "https://*.pinterest.com.mx/*",
    "https://*.pinterest.com.br/*",
    "https://www.instagram.com/*",
    "https://instagram.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://m.youtube.com/*",
    "https://www.tiktok.com/*",
    "https://tiktok.com/*",
    "https://m.tiktok.com/*",
    "https://vm.tiktok.com/*"
  ],

  "action": {
    "default_title": "Send to Media Hub",
    "default_popup": "popup.html"
  },

  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content-portal.js", "content-twitter.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.reddit.com/*",
        "https://reddit.com/*"
      ],
      "js": ["content-portal.js", "content-reddit.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.pinterest.com/*",
        "https://pinterest.com/*",
        "https://*.pinterest.co.uk/*",
        "https://*.pinterest.ca/*",
        "https://*.pinterest.com.au/*",
        "https://*.pinterest.de/*",
        "https://*.pinterest.fr/*",
        "https://*.pinterest.es/*",
        "https://*.pinterest.it/*",
        "https://*.pinterest.jp/*",
        "https://*.pinterest.com.mx/*",
        "https://*.pinterest.com.br/*"
      ],
      "js": ["content-portal.js", "content-pinterest.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.instagram.com/*",
        "https://instagram.com/*"
      ],
      "js": ["content-portal.js", "content-instagram.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*",
        "https://m.youtube.com/*"
      ],
      "js": ["content-portal.js", "content-youtube.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.tiktok.com/*",
        "https://tiktok.com/*",
        "https://m.tiktok.com/*",
        "https://vm.tiktok.com/*"
      ],
      "js": ["content-portal.js", "content-tiktok.js"],
      "css": ["content-overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "_comment_war": "1.13.x — the quick-menu popover uses the app's Geist font so it matches Media Hub exactly. Fonts referenced from content-overlay.css must be page-accessible.",
  "web_accessible_resources": [
    {
      "resources": ["fonts/geist-400.woff2", "fonts/geist-600.woff2"],
      "matches": ["<all_urls>"]
    }
  ],

  "commands": {
    "send-video": {
      "suggested_key": {
        "default": "Ctrl+Shift+Y",
        "mac": "Command+Shift+Y"
      },
      "description": "Send current tab to Media Hub (video)"
    },
    "send-mp3": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Send current tab to Media Hub as MP3"
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "media-hub-bridge@mediahub.local",
      "strict_min_version": "109.0"
    }
  }
}
