# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Packaged extension uploads (built on demand for the Chrome Web Store)
media-hub-extension-*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Sidecar binaries — fetched via scripts/fetch-sidecars.ps1
src-tauri/binaries/*.exe
src-tauri/binaries/yt-dlp*
src-tauri/binaries/ffmpeg*
src-tauri/binaries/deno*

# Rust build artifacts
src-tauri/target/
# Convenience shortcut to the build target dir (per-developer)
src-tauri/target.lnk

# Library data (per-user, never committed)
*.db
*.db-shm
*.db-wal

# Tauri updater signing keys — NEVER commit. Real keys live at
# ~/.tauri/media-hub.key{,.pub}. This catches accidental copies.
*.key
*.key.pub

# Packaged extension artifact (build output, not source)
*.rar

# Cookie / session files (credentials — NEVER commit)
*cookies*.txt
cookies*.txt
*.cookies
